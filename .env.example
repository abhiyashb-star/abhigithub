# ============================================================
# GEMINI PRO AUTOMATION PLATFORM - ENVIRONMENT CONFIGURATION
# Copy this to .env and fill in your values
# ============================================================

# GEMINI API CONFIGURATION
# Get your API key from: https://ai.google.dev/
GEMINI_API_KEY=your_gemini_pro_api_key_here

# SUPABASE DATABASE
# Get from: https://supabase.com/
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_key_here
DB_NAME=gemini_db
DB_USER=postgres
DB_PASSWORD=your_secure_password

# STRIPE PAYMENTS
# Get from: https://stripe.com/
STRIPE_KEY=sk_test_your_stripe_key_here
STRIPE_PUBLIC_KEY=pk_test_your_public_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# GOOGLE SERVICES
# Gmail API (optional, for email automation)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_OAUTH_REDIRECT=http://localhost:3000/auth/google/callback

# GEMINI TOOLS CONFIGURATION
# Enable/disable specific tools
ENABLE_GOOGLE_SEARCH=true
ENABLE_URL_CONTEXT=true
ENABLE_CODE_EXECUTION=true
ENABLE_FILE_SEARCH=true
ENABLE_EMAIL_SENDING=true
ENABLE_DATABASE_QUERY=true
ENABLE_SLACK_WEBHOOK=true

# OPENAI (Optional backup, not recommended)
OPENAI_API_KEY=sk_your_openai_key_optional

# SLACK INTEGRATION (optional)
SLACK_BOT_TOKEN=xoxb_your_slack_token
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# WEBSITE CONFIGURATION
WEBSITE_URL=http://localhost:3000
API_URL=http://localhost:8000
ENVIRONMENT=development

# FRONTEND CONFIGURATION
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_GEMINI_ENABLED=true

# LOGGING
LOG_LEVEL=INFO
LOG_FILE=logs/app.log
DEBUG_MODE=false

# SECURITY
SECRET_KEY=your_random_secret_key_for_jwt
JWT_EXPIRATION=24  # hours
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# PERFORMANCE
MAX_WORKERS=4
REQUEST_TIMEOUT=30
RATE_LIMIT=100  # requests per minute

# MONITORING
PROMETHEUS_ENABLED=true
GRAFANA_ENABLED=true
SENTRY_DSN=  # optional error tracking

# EMAIL NOTIFICATIONS
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_app_password
NOTIFICATION_EMAIL=your_email@example.com

# LOCAL AGENTS CONFIGURATION
EMAIL_CHECK_INTERVAL=5  # minutes
LEAD_GENERATION_INTERVAL=30  # minutes
WEBSITE_MONITOR_INTERVAL=5  # minutes
DATA_SYNC_INTERVAL=60  # minutes

# REVENUE & PRICING
PRODUCT_EMAIL_AGENT_PRICE=99  # USD/month
PRODUCT_RESUME_BUILDER_PRICE=10  # USD per resume
PRODUCT_WEB_SCRAPER_PRICE=49  # USD/month
PRODUCT_DOCUMENT_ANALYZER_PRICE=39  # USD/month
PRODUCT_DATA_ANALYST_PRICE=59  # USD/month

# MARKETING & TRACKING
GOOGLE_ANALYTICS_ID=G_your_analytics_id
TWITTER_API_KEY=your_twitter_api_key
PRODUCTHUNT_WEBHOOK=your_webhook_url

# DEVELOPMENT ONLY
MOCK_RESPONSES=false
TEST_MODE=false
SAMPLE_DATA_ENABLED=false
